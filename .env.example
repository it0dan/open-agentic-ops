# Sensedia AI Gateway (LLM provider)
AI_GATEWAY_OAUTH_ENDPOINT=
AI_GATEWAY_CLIENT_ID=
AI_GATEWAY_CLIENT_SECRET=

# LangSmith (tracing/avaliação agêntica)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=open-agentic-ops

# Infra (checkpointer/board e notificação HITL)
DATABASE_URL=postgresql://openops:openops@localhost:5432/openops
REDIS_URL=

# Similaridade semântica (decisão 2 — pgvector + Sentence-Transformers local)
SIMILARIDADE_THRESHOLD=0.75
SIMILARIDADE_N=5
