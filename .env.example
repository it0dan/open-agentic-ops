# Sensedia AI Gateway (LLM provider)
# Modo único (compatibilidade): um par de credenciais + endpoint para todos.
AI_GATEWAY_OAUTH_ENDPOINT=
AI_GATEWAY_CLIENT_ID=
AI_GATEWAY_CLIENT_SECRET=
AI_GATEWAY_CHAT_ENDPOINT=

# Modo multi-agente: um par de credenciais + endpoint POR agente (contrato
# oao-endpoints-and-scopes). Sufixo = agente em MAIÚSCULAS com hífen → underscore.
# Ex.: feature-backend → AI_GATEWAY_FEATURE_BACKEND_*. Agentes: INTAKE,
# FEATURE_BACKEND, FEATURE_FRONTEND, PLATFORM, REVIEW, ARCHITECTURE, SRE.
# O runtime usa estas vars quando AI_GATEWAY_OAUTH_ENDPOINT está preenchido.
AI_GATEWAY_INTAKE_CLIENT_ID=
AI_GATEWAY_INTAKE_CLIENT_SECRET=
AI_GATEWAY_INTAKE_CHAT_ENDPOINT=
AI_GATEWAY_FEATURE_BACKEND_CLIENT_ID=
AI_GATEWAY_FEATURE_BACKEND_CLIENT_SECRET=
AI_GATEWAY_FEATURE_BACKEND_CHAT_ENDPOINT=
AI_GATEWAY_FEATURE_FRONTEND_CLIENT_ID=
AI_GATEWAY_FEATURE_FRONTEND_CLIENT_SECRET=
AI_GATEWAY_FEATURE_FRONTEND_CHAT_ENDPOINT=
AI_GATEWAY_PLATFORM_CLIENT_ID=
AI_GATEWAY_PLATFORM_CLIENT_SECRET=
AI_GATEWAY_PLATFORM_CHAT_ENDPOINT=
AI_GATEWAY_REVIEW_CLIENT_ID=
AI_GATEWAY_REVIEW_CLIENT_SECRET=
AI_GATEWAY_REVIEW_CHAT_ENDPOINT=
AI_GATEWAY_ARCHITECTURE_CLIENT_ID=
AI_GATEWAY_ARCHITECTURE_CLIENT_SECRET=
AI_GATEWAY_ARCHITECTURE_CHAT_ENDPOINT=
AI_GATEWAY_SRE_CLIENT_ID=
AI_GATEWAY_SRE_CLIENT_SECRET=
AI_GATEWAY_SRE_CHAT_ENDPOINT=

# Keycloak (auth real OAuth2 client_credentials + JWT)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=oao
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/oao/protocol/openid-connect/certs
# Modo de auth da superfície /oao/*: "jwt" (real) ou "header" (dev/teste)
OAO_AUTH_MODE=jwt

# LangSmith (tracing/avaliação agêntica)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=open-agentic-ops

# Infra (checkpointer/board e notificação HITL)
DATABASE_URL=postgresql://openops:openops@localhost:5432/openops
REDIS_URL=

# Similaridade semântica (decisão 2 — pgvector + Sentence-Transformers local)
SIMILARIDADE_THRESHOLD=0.75
SIMILARIDADE_N=5
